package hbm_coverage_pkg;

import uvm_pkg::*;
`include "uvm_macros.svh"

// ------------------------------------------------------------
// Coverage Configuration
// ------------------------------------------------------------
class coverage_config extends uvm_object;
    `uvm_object_utils(coverage_config)

    bit enable_bank_conflict_cov = 1;
    bit enable_row_hit_cov = 1;
    bit enable_queue_cov = 1;
    bit enable_cmd_cov = 1;
    bit enable_timing_cov = 1;

    int bank_count = 16;
    int queue_depth = 32;

    function new(string name = "coverage_config");
        super.new(name);
    endfunction
endclass

// ------------------------------------------------------------
// Coverage Monitor
// ------------------------------------------------------------
class hbm_coverage extends uvm_component;
    `uvm_component_utils(hbm_coverage)

    uvm_analysis_imp #(hbm_transaction, hbm_coverage) item_export;
    coverage_config cfg;

    // Transaction tracking
    hbm_transaction trans_history[$];
    int max_history = 1000;

    // Previous transaction for comparison
    hbm_transaction prev_trans;
    hbm_transaction prev_act_trans;

    // Previous bank for conflict detection
    bit [7:0] last_bank;

    // Statistics counters
    int row_hits = 0;
    int row_misses = 0;
    int row_conflicts = 0;
    int bank_conflicts = 0;
    int total_transactions = 0;

    // Per-bank last activated row tracking
    bit [15:0] last_act_row[16];
    bit        bank_open[16];
    int        banks_accessed[16];

    // Queue fullness tracking
    int queue_fill_level[$];
    int max_queue_observed = 0;

    // Command sequence tracking
    int act_count = 0;
    int pre_count = 0;
    int rd_count = 0;
    int wr_count = 0;
    int ref_count = 0;
    int idle_count = 0;

    // Timing tracking
    int idle_cycles = 0;
    int prev_time = 0;

    // ============================================================
    // Covergroup: Command Type Coverage
    // Generic command coverage - handles both READ/WRITE and ACT/PRE/REF
    // ============================================================
    covergroup cmd_type_cg with function sample(bit [7:0] cmd);
        option.per_instance = 1;
        option.name = "cmd_type_cg";

        // Generic command bins - maps to various enum values
        coverpoint cmd {
            bins read  = {[0:0]};   // READ command
            bins write = {[1:1]};   // WRITE command
            bins act   = {[2:2]};   // ACT command
            bins pre   = {[3:3]};   // PRE command
            bins refresh = {[4:4]}; // REF command
            bins idle  = {[5:5]};   // IDLE
        }
    endgroup

    // ============================================================
    // Covergroup: Command Type with Bank Cross-Coverage
    // ============================================================
    covergroup cmd_bank_cross_cg with function sample(bit [7:0] cmd, bit [7:0] bank);
        option.per_instance = 1;
        option.name = "cmd_bank_cross_cg";

        coverpoint cmd {
            bins rd   = {[0:0]};   // READ command
            bins wr   = {[1:1]};   // WRITE command
            bins act  = {[2:2]};   // ACT command
            bins pre  = {[3:3]};   // PRE command
        }

        coverpoint bank {
            bins banks[] = {[0:15]};
            bins bank_low = {[0:3]};
            bins bank_med = {[4:11]};
            bins bank_high = {[12:15]};
        }

        cross cmd, bank;
    endgroup

    // ============================================================
    // Covergroup: Bank Conflict Coverage
    // ============================================================
    covergroup bank_conflict_cg;
        option.per_instance = 1;
        option.name = "bank_conflict_cg";

        // Track conflict patterns
        coverpoint conflict_type {
            bins no_conflict  = {0};
            bins row_conflict = {1};
            bins bank_conflict = {2};
            bins both_conflict = {3};
        }

        // Bank groups for HBM organization
        coverpoint bank_group {
            bins bg0 = {[0:3]};
            bins bg1 = {[4:7]};
            bins bg2 = {[8:11]};
            bins bg3 = {[12:15]};
        }
    endgroup

    // ============================================================
    // Covergroup: Row Hit/Miss Rate Coverage
    // ============================================================
    covergroup row_hit_miss_cg with function sample(bit hit, bit conflict);
        option.per_instance = 1;
        option.name = "row_hit_miss_cg";

        coverpoint hit {
            bins hit  = {1};
            bins miss = {0};
        }

        coverpoint conflict {
            bins conflict  = {1};
            bins no_conflict = {0};
        }

        // Cross hit and conflict for detailed analysis
        cross hit, conflict {
            bins hit_no_conflict = binsof(hit.hit) and binsof(conflict.no_conflict);
            bins hit_with_conflict = binsof(hit.hit) and binsof(conflict.conflict);
            bins miss_no_conflict = binsof(hit.miss) and binsof(conflict.no_conflict);
            bins miss_with_conflict = binsof(hit.miss) and binsof(conflict.conflict);
            ignore_bins invalid = binsof(hit.hit) and binsof(conflict);  // Can't have hit and conflict
        }
    endgroup

    // ============================================================
    // Covergroup: Row Hit Rate Bins
    // ============================================================
    covergroup hit_rate_cg with function sample(int rate_pct);
        option.per_instance = 1;
        option.name = "hit_rate_cg";

        // Bins for hit rate percentage ranges
        coverpoint rate_pct {
            bins very_low    = {[0:20]};
            bins low         = {[21:40]};
            bins medium      = {[41:60]};
            bins high        = {[61:80]};
            bins very_high   = {[81:100]};
        }
    endgroup

    // ============================================================
    // Covergroup: Queue Fullness Coverage
    // ============================================================
    covergroup queue_fullness_cg with function sample(int fill_level, int max_depth);
        option.per_instance = 1;
        option.name = "queue_fullness_cg";

        // Normalized fullness percentage
        coverpoint fullness_percent {
            bins empty      = {[0:5]};
            bins low        = {[6:25]};
            bins medium     = {[26:50]};
            bins high       = {[51:75]};
            bins near_full  = {[76:95]};
            bins full       = {[96:100]};
        }

        // Sample when fill_level changes
        function sample(int fill_level, int max_depth);
            automatic int pct = (fill_level * 100) / (max_depth > 0 ? max_depth : 1);
            queue_fullness_cg.sample(pct);
            if (fill_level > max_queue_observed)
                max_queue_observed = fill_level;
        endfunction
    endgroup

    // ============================================================
    // Covergroup: Queue Depth Transitions
    // ============================================================
    covergroup queue_transition_cg;
        option.per_instance = 1;
        option.name = "queue_transition_cg";

        coverpoint transition_type {
            bins empty_to_fill = {[0:1]};   // Going from empty to 1
            bins fill_to_empty = {[1:2]};   // Going from 1 to empty
            bins small_to_large = {[2:3]};   // Significant increase
            bins large_to_small = {[3:4]};   // Significant decrease
            bins stable = {[4:5]};           // Same level
        }
    endgroup

    // ============================================================
    // Covergroup: Bank State Coverage
    // ============================================================
    covergroup bank_state_cg with function sample(bit open, bit [15:0] row);
        option.per_instance = 1;
        option.name = "bank_state_cg";

        coverpoint open {
            bins closed = {0};
            bins open = {1};
        }

        coverpoint row {
            bins low_row  = {[0:255]};
            bins med_row  = {[256:16383]};
            bins high_row = {[16384:65535]};
        }
    endgroup

    // ============================================================
    // Covergroup: Address Pattern Coverage
    // ============================================================
    covergroup addr_pattern_cg with function sample(bit [31:0] addr);
        option.per_instance = 1;
        option.name = "addr_pattern_cg";

        coverpoint addr[7:4] {
            bins sequential = {[0:15]};
            bins random = {[16:31]};
            bins hotspot_low = {[32:47]};
            bins hotspot_high = {[48:63]};
        }
    endgroup

    // ============================================================
    // Covergroup: Timing Coverage
    // ============================================================
    covergroup timing_cg;
        option.per_instance = 1;
        option.name = "timing_cg";

        coverpoint idle_cycles {
            bins idle0     = {0};
            bins idle1_5   = {[1:5]};
            bins idle6_10  = {[6:10]};
            bins idle_gte10 = {[10:$]};
        }
    endgroup

    // ============================================================
    // Covergroup: Command Sequence Coverage
    // ============================================================
    covergroup cmd_sequence_cg;
        option.per_instance = 1;
        option.name = "cmd_sequence_cg";

        coverpoint sequence_type {
            bins act_then_rd = {0};
            bins act_then_wr = {1};
            bins act_pre_rd = {2};
            bins act_pre_wr = {3};
            bins rd_wr_same_bank = {4};
            bins wr_rd_same_bank = {5};
            bins ref_refresh = {6};
            bins back_to_back = {7};
        }
    endgroup

    // ============================================================
    // Covergroup: ECC/CRC Error Coverage
    // ============================================================
    covergroup error_cg;
        option.per_instance = 1;
        option.name = "error_cg";

        coverpoint error_type {
            bins no_error = {0};
            bins ecc_correctable = {1};
            bins ecc_uncorrectable = {2};
            bins crc_error = {3};
        }
    endgroup

    // ============================================================
    // Constructor
    // ============================================================
    function new(string name, uvm_component parent);
        super.new(name, parent);
        item_export = new("item_export", this);

        // Initialize covergroups
        cmd_type_cg = new();
        cmd_bank_cross_cg = new();
        bank_conflict_cg = new();
        row_hit_miss_cg = new();
        hit_rate_cg = new();
        queue_fullness_cg = new();
        queue_transition_cg = new();
        bank_state_cg = new();
        addr_pattern_cg = new();
        timing_cg = new();
        cmd_sequence_cg = new();
        error_cg = new();

        // Initialize bank tracking
        for (int i = 0; i < 16; i++) begin
            last_act_row[i] = 0;
            bank_open[i] = 0;
            banks_accessed[i] = 0;
        end
    endfunction

    function void build_phase(uvm_phase phase);
        super.build_phase(phase);

        if (!uvm_config_db #(coverage_config)::get(this, "", "coverage_cfg", cfg))
            cfg = coverage_config::type_id::create("cfg");

        `uvm_info(get_name(), "Coverage build complete", UVM_MEDIUM)
    endfunction

    // ============================================================
    // Write function - called for each transaction
    // ============================================================
    virtual function void write(hbm_transaction t);
        bit hit = 0;
        bit conflict = 0;
        int conflict_type = 0;
        int last_queue_size = queue_fill_level.size();

        // Store transaction
        trans_history.push_back(t);
        if (trans_history.size() > max_history)
            trans_history.pop_front();

        total_transactions++;

        // Update command counts
        case (t.cmd)
            hbm_transaction::READ:  rd_count++;
            hbm_transaction::WRITE: wr_count++;
            default: begin
                // For extended commands, track separately
                if (t.cmd == hbm_transaction::READ) rd_count++;
                else if (t.cmd == hbm_transaction::WRITE) wr_count++;
            end
        endcase

        // Analyze row hit/miss for data commands
        if (prev_trans != null) begin
            if (t.addr_bank == prev_trans.addr_bank) begin
                if (t.addr_row == prev_trans.addr_row) begin
                    hit = 1;
                    row_hits++;
                    conflict_type = 0;
                end else begin
                    conflict = 1;
                    row_conflicts++;
                    conflict_type = 1;
                    // Check if bank was open (row conflict)
                    if (bank_open[t.addr_bank])
                        conflict_type = 3;  // both bank and row conflict
                end
            end else begin
                // Bank conflict - different bank accessed
                bank_conflicts++;
                if (conflict) conflict_type = 2;
            end
        end else begin
            row_misses++;  // First access is always a miss
            conflict_type = 0;
        end

        // Update bank state tracking
        banks_accessed[t.addr_bank]++;
        if (t.cmd == hbm_transaction::WRITE || t.cmd == hbm_transaction::READ) begin
            bank_state_cg.sample(bank_open[t.addr_bank], t.addr_row);
        end

        // Update history
        prev_trans = t;
        last_bank = t.addr_bank;

        // Sample covergroups
        cmd_type_cg.sample(t.cmd);
        cmd_bank_cross_cg.sample(t.cmd, t.addr_bank);
        bank_conflict_cg.sample(conflict_type, t.addr_bank);
        row_hit_miss_cg.sample(hit, conflict);
        addr_pattern_cg.sample(t.addr);

        // Update queue fullness tracking
        queue_fill_level.push_back(total_transactions);
        if (queue_fill_level.size() > cfg.queue_depth)
            queue_fill_level.pop_front();
        queue_fullness_cg.sample(queue_fill_level.size(), cfg.queue_depth);

        // Track queue transitions
        if (last_queue_size == 0 && queue_fill_level.size() > 0)
            queue_transition_cg.sample(0);  // empty to fill
        else if (last_queue_size > 0 && queue_fill_level.size() == 0)
            queue_transition_cg.sample(1);  // fill to empty
        else if (queue_fill_level.size() > last_queue_size + 5)
            queue_transition_cg.sample(2);  // small to large
        else if (queue_fill_level.size() + 5 < last_queue_size)
            queue_transition_cg.sample(3);  // large to small
        else
            queue_transition_cg.sample(4);  // stable

        `uvm_info(get_name(), $sformatf(
            "Coverage: hits=%0d misses=%0d conflicts=%0d bank_conflicts=%0d",
            row_hits, row_misses, row_conflicts, bank_conflicts), UVM_FULL)
    endfunction

    // ============================================================
    // Update queue fullness from external source
    // ============================================================
    function void update_queue_fullness(int fill_level);
        int last_size = queue_fill_level.size();
        queue_fullness_cg.sample(fill_level, cfg.queue_depth);
        queue_fill_level.push_back(fill_level);
        if (queue_fill_level.size() > cfg.queue_depth)
            queue_fill_level.pop_front();
        if (fill_level > max_queue_observed)
            max_queue_observed = fill_level;
    endfunction

    // ============================================================
    // Update timing information
    // ============================================================
    function void update_timing(int current_time);
        int cycle_diff = current_time - prev_time;
        if (cycle_diff > 0) begin
            idle_cycles += cycle_diff - 1;  // Subtract 1 for the transaction cycle
        end
        timing_cg.sample();
        prev_time = current_time;
    endfunction

    // ============================================================
    // Record ACT command
    // ============================================================
    function void record_act(bit [7:0] bank, bit [15:0] row);
        act_count++;
        last_act_row[bank] = row;
        bank_open[bank] = 1;
        cmd_type_cg.sample(8'd2);  // ACT command value
        cmd_bank_cross_cg.sample(8'd2, bank);
    endfunction

    // ============================================================
    // Record PRE command
    // ============================================================
    function void record_pre(bit [7:0] bank);
        pre_count++;
        bank_open[bank] = 0;
        cmd_type_cg.sample(8'd3);  // PRE command value
        cmd_bank_cross_cg.sample(8'd3, bank);
    endfunction

    // ============================================================
    // Record REF command
    // ============================================================
    function void record_ref();
        ref_count++;
        // Close all banks after refresh
        for (int i = 0; i < 16; i++)
            bank_open[i] = 0;
        cmd_type_cg.sample(8'd4);  // REF command value
    endfunction

    // ============================================================
    // Record error
    // ============================================================
    function void record_error(bit [1:0] error_type);
        error_cg.sample(error_type);
    endfunction

    // ============================================================
    // Extract phase - calculate final hit rate
    // ============================================================
    function void extract_phase(uvm_phase phase);
        real hit_rate;
        super.extract_phase(phase);

        hit_rate = row_hits * 100.0 / (row_hits + row_misses + row_conflicts + 0.001);
        hit_rate_cg.sample(int'(hit_rate));

        `uvm_info(get_name(), $sformatf(
            "=== Coverage Summary ===\n" //
            "Total Transactions: %0d\n" //
            "Row Hits: %0d\n" //
            "Row Misses: %0d\n" //
            "Row Conflicts: %0d\n" //
            "Bank Conflicts: %0d\n" //
            "Hit Rate: %0.2f%%\n" //
            "ACT: %0d  PRE: %0d  RD: %0d  WR: %0d  REF: %0d\n" //
            "Max Queue Observed: %0d",
            total_transactions,
            row_hits, row_misses, row_conflicts, bank_conflicts,
            hit_rate,
            act_count, pre_count, wr_count, rd_count, ref_count,
            max_queue_observed
        ), UVM_MEDIUM)
    endfunction

    // ============================================================
    // Report phase - final coverage report
    // ============================================================
    function void report_phase(uvm_phase phase);
        real hit_rate;
        real conflict_rate;
        super.report_phase(phase);

        hit_rate = row_hits * 100.0 / (row_hits + row_misses + row_conflicts + 0.001);
        conflict_rate = row_conflicts * 100.0 / (total_transactions + 0.001);

        `uvm_info(get_name(), $sformatf(
            "=== Final Coverage Report ===\n" //
            "----------------------------------------\n" //
            "Transaction Statistics:\n" //
            "  Total Transactions: %0d\n" //
            "  Row Hits: %0d (%.2f%%)\n" //
            "  Row Misses: %0d\n" //
            "  Row Conflicts: %0d (%.2f%%)\n" //
            "  Bank Conflicts: %0d\n" //
            "----------------------------------------\n" //
            "Command Distribution:\n" //
            "  ACT: %0d\n" //
            "  PRE: %0d\n" //
            "  READ: %0d\n" //
            "  WRITE: %0d\n" //
            "  REFRESH: %0d\n" //
            "----------------------------------------\n" //
            "Queue Statistics:\n" //
            "  Max Queue Fill: %0d\n" //
            "  Queue Depth Config: %0d\n" //
            "----------------------------------------\n" //
            "Per-Bank Access Counts:\n" //
            "  %0d %0d %0d %0d\n" //
            "  %0d %0d %0d %0d\n" //
            "  %0d %0d %0d %0d\n" //
            "  %0d %0d %0d %0d",
            total_transactions,
            row_hits, hit_rate,
            row_misses,
            row_conflicts, conflict_rate,
            bank_conflicts,
            act_count,
            pre_count,
            rd_count,
            wr_count,
            ref_count,
            max_queue_observed,
            cfg.queue_depth,
            banks_accessed[0], banks_accessed[1], banks_accessed[2], banks_accessed[3],
            banks_accessed[4], banks_accessed[5], banks_accessed[6], banks_accessed[7],
            banks_accessed[8], banks_accessed[9], banks_accessed[10], banks_accessed[11],
            banks_accessed[12], banks_accessed[13], banks_accessed[14], banks_accessed[15]
        ), UVM_MEDIUM)
    endfunction

    // ============================================================
    // Get coverage statistics
    // ============================================================
    function void get_stats(output int hits, output int misses,
                           output int conflicts, output int total);
        hits = row_hits;
        misses = row_misses;
        conflicts = row_conflicts;
        total = total_transactions;
    endfunction

    // ============================================================
    // Reset statistics
    // ============================================================
    function void reset_stats();
        row_hits = 0;
        row_misses = 0;
        row_conflicts = 0;
        bank_conflicts = 0;
        total_transactions = 0;
        act_count = 0;
        pre_count = 0;
        rd_count = 0;
        wr_count = 0;
        ref_count = 0;
        idle_count = 0;
        idle_cycles = 0;
        max_queue_observed = 0;
        trans_history.delete();
        queue_fill_level.delete();
        for (int i = 0; i < 16; i++) begin
            last_act_row[i] = 0;
            bank_open[i] = 0;
            banks_accessed[i] = 0;
        end
        `uvm_info(get_name(), "Coverage statistics reset", UVM_MEDIUM)
    endfunction

endclass : hbm_coverage

// ------------------------------------------------------------
// Queue Coverage Agent
// Monitors queue fullness independently
// ------------------------------------------------------------
class queue_coverage_agent extends uvm_component;
    `uvm_component_utils(queue_coverage_agent)

    uvm_analysis_imp #(hbm_transaction, queue_coverage_agent) item_export;

    int queue_depth;
    int current_fill;
    int max_fill_observed;

    // Queue fill history
    int fill_history[$];
    int max_history = 100;

    // Covergroups for queue
    covergroup queue_fill_cg with function sample(int fill, int depth);
        option.per_instance = 1;
        coverpoint fill {
            bins empty     = {0};
            bins quarter   = {[1:8]};
            bins half      = {[9:16]};
            bins three_qtr = {[17:24]};
            bins full      = {[25:32]};
        }
    endgroup

    covergroup queue_rate_cg;
        option.per_instance = 1;
        coverpoint fill_rate {
            bins increasing = {[0:2]};
            bins decreasing = {[3:5]};
            bins stable = {[6:7]};
        }
    endgroup

    function new(string name, uvm_component parent);
        super.new(name, parent);
        item_export = new("item_export", this);
        queue_depth = 32;
        current_fill = 0;
        max_fill_observed = 0;
    endfunction

    function void write(hbm_transaction t);
        // Estimate queue fill based on transaction type
        if (t.cmd == hbm_transaction::READ || t.cmd == hbm_transaction::WRITE) begin
            current_fill++;
            if (current_fill > max_fill_observed)
                max_fill_observed = current_fill;
        end

        queue_fill_cg.sample(current_fill, queue_depth);

        fill_history.push_back(current_fill);
        if (fill_history.size() > max_history)
            fill_history.pop_front();

        // Calculate fill rate
        if (fill_history.size() >= 2) begin
            int rate;
            int prev_fill = fill_history[fill_history.size()-2];
            if (current_fill > prev_fill)
                rate = 0;
            else if (current_fill < prev_fill)
                rate = 3;
            else
                rate = 6;
            queue_rate_cg.sample();
        end

        // Decrement on completion (simplified)
        if (current_fill > 0)
            current_fill--;
    endfunction
endclass : queue_coverage_agent

endpackage : hbm_coverage_pkg

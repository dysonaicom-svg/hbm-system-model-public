{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/ic/JXTF/HBM"
      ],
      "env": {
        "ALLOWED_DIRECTORY": "/home/ic/JXTF/HBM"
      }
    },
    "fetch": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "markfetch"
      ],
      "env": {}
    },
    "tavily": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ],
      "env": {}
    },
    "thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    },
    "papers": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "arxiv-mcp-server",
        "arxiv-mcp-server"
      ],
      "env": {}
    },
    "discord": {
      "command": "/home/ic/.claude/channels/discord/discord-mcp-wrapper.sh"
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {}
    },
    "vivado": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "vivado-mcp"
      ],
      "env": {
        "VIVADO_PATH": "/opt/Xilinx/Vivado/2023.1/bin/vivado"
      }
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    }
  }
}
